NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MetaApi — get your token at https://app.metaapi.cloud
METAAPI_TOKEN=your-metaapi-token

ANTHROPIC_API_KEY=your_key_here

# Set to "true" to re-enable the paid-plan gate and billing UI (off by
# default for pre-launch solo use). See lib/payments.ts.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Set to "true" to lock the whole app down to just the landing page
# ("coming soon" mode). Visitors need EARLY_ACCESS_CODE (entered on the
# landing page, or via ?access=CODE) to reach the rest of the app.
# See lib/early-access.ts and middleware.ts.
COMING_SOON=false
EARLY_ACCESS_CODE=your-invite-code

